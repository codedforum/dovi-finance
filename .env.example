# Copy to .env and fill in your own values. Nothing here is a real value.
# Tests and the local dev server (DOVI_ENV=dev node tools/dev-server.js) need none of these.

DOVI_ENV=dev
DOVI_URL=http://localhost:3399
PORT=3399
DOVI_NETWORK=sepolia
DOVI_DB_PATH=data/dovi.db

# Base
BASE_RPC_URL=https://sepolia.base.org
BASE_USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e
DOVI_CLAIM_CONTRACT=0x07e5bE5687b739024f28bf8c85faf1d6E14fDbd4
DOVI_CLAIM_DEPLOY_BLOCK=0

# Coinbase CDP wallets
CDP_PROJECT_ID=your-cdp-project-id
CDP_API_KEY_ID=your-cdp-api-key-id
CDP_API_KEY_SECRET=your-cdp-api-key-secret
DOVI_CDP_JWT_KEY_PATH=data/cdp-jwt.key
DOVI_ATTESTER_ACCOUNT=your-attester-account-name
DOVI_EXECUTOR_ACCOUNT=your-executor-account-name

# Sign in with X and Google
X_CLIENT_ID=your-x-client-id
X_CLIENT_SECRET=your-x-client-secret
X_REDIRECT_URI=http://localhost:3399/auth/x/callback
GOOGLE_CLIENT_ID=your-google-client-id

# Email codes
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=DOVI <noreply@example.com>

# Naira rail, test mode
DOVI_NAIRA=1
KORA_SECRET_KEY=your-kora-test-secret-key

# Ask DOVI language model
RELAYSTATION_API_KEY=your-llm-api-key
RELAYSTATION_BASE_URL=https://llm.example.com/v1
RELAYSTATION_MODEL=your-model-name
